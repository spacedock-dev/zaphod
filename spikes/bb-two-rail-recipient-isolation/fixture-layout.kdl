// Test-only: this layout is opened twice in one isolated session.
layout {
    tab name="recipient-target" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane size=28 borderless=true name="recipient-rail" {
                plugin location="__WASM_URL__" {
                    rail "1"
                    debug "1"
                }
            }
            pane name="same-cwd-terminal" cwd="__SAME_CWD__"
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
