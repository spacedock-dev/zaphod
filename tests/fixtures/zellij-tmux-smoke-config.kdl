// Valid operator-owned config for the real Zellij/tmux smoke test.
// The selected-checkout entry must preserve every byte, including the quoted
// brace and the unrelated fixed-layout shortcut.
keybinds {
    locked {
        bind "Alt /" { NoOp; }
        bind "Alt Shift x" { WriteChars "{"; }
        bind "Alt Shift z" {
            NewTab { layout "<FIXED_OPERATOR_LAYOUT>"; }
        }
    }
    shared_except "locked" {
        bind "Alt /" { NoOp; }
    }
}
