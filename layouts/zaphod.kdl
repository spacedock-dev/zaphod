// Zaphod agent-tab layout: a docked pane-switcher sidebar you can toggle.
// Two swap layouts let Alt-/ (or the header's toggle) flip between:
//   docked   — sidebar reserves a 26-col column on the left, agents stacked right
//   undocked — agents take the full width; the sidebar collapses into the stack
// next_swap_layout() rearranges the tab's existing panes between these states
// without spawning shells or reloading the plugin.
//
// __ZAPHOD_WASM__ is substituted with the absolute built-wasm path by install.sh.
// The sidebar plugin carries `rail "1"` so the Alt-/ keybind shares its identity
// and the toggle pipe reaches this docked instance.
layout {
    swap_tiled_layout name="docked" {
        tab {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane split_direction="vertical" {
                pane size=26 borderless=true name="sidebar" {
                    plugin location="__ZAPHOD_WASM__" {
                        rail "1"
                    }
                }
                pane stacked=true {
                    children
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }
    swap_tiled_layout name="undocked" {
        tab {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane stacked=true {
                children
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }
    tab name="zaphod" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane size=26 borderless=true name="sidebar" {
                plugin location="__ZAPHOD_WASM__" {
                    rail "1"
                }
            }
            pane stacked=true {
                children
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
